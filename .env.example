# ==============================================================================
# Universal Agentic Commerce Node - Environment Configuration
# ==============================================================================

# Node Identity & Port
APP_NAME="Universal Agentic Commerce Node"
ENVIRONMENT="production"
PORT=8000
PUBLIC_BASE_URL="https://agentic-commerce-node.onrender.com"

# Active Merchant Identity (Options: 'dominos_in', 'beastlife_d2c', 'havells_tech')
ACTIVE_MERCHANT_ID="dominos_in"

# Database Rails (Neon Serverless PostgreSQL or Local SQLite)
# Example Neon URL: postgresql+psycopg2://user:pass@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="sqlite:///./agentic_commerce.db"

# State & Gatekeeper Rails (Upstash Redis)
# Example: rediss://default:your_token@your-endpoint.upstash.io:6379
REDIS_URL=""

# Financial Rails (Razorpay Test Mode Rails)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_SANDBOX_MODE="true"

# Quotation Temporal Bounds
QUOTE_VALIDITY_MINUTES=15
