# ==============================================================================
# Payvlo Commerce Node - Production Environment Configuration
# ==============================================================================

# Server & Node
ENVIRONMENT="production"
PYTHON_VERSION="3.12.8"
PORT=8000
PUBLIC_BASE_URL="https://your-app-name.onrender.com"

# Security & JWT Token Signing
JWT_SECRET_KEY="your_secure_random_jwt_secret_key"

# Database Rails (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql+psycopg2://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Gatekeeper & Concurrency Locks (Upstash Redis)
REDIS_URL="rediss://default:your_token@your-endpoint.upstash.io:6379"

# Financial Rails (Razorpay API Keys)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_SANDBOX_MODE="true"

# Quotation Validity (Minutes)
QUOTE_VALIDITY_MINUTES=15
